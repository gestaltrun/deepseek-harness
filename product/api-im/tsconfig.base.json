{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@gestaltrun/dsh-im-runtime": [
        "../im-runtime/src/index.ts"
      ],
      "@gestaltrun/dsh-im-runtime/types": [
        "../im-runtime/src/types.ts"
      ]
    }
  }
}
