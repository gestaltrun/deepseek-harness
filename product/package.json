{
  "name": "@gestaltrun/product",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm --filter @gestaltrun/dsh-model-center build && pnpm --filter @gestaltrun/dsh-account-pool build",
    "test": "pnpm --filter @gestaltrun/dsh-model-center test && pnpm --filter @gestaltrun/dsh-account-pool test",
    "typecheck": "pnpm --filter @gestaltrun/dsh-model-center typecheck && pnpm --filter @gestaltrun/dsh-account-pool typecheck",
