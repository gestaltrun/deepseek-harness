{
  "name": "@gestaltrun/dsh-ui-im",
  "version": "0.1.0-gestaltrun.0",
  "description": "IM account settings, workspace takeover settings, and sidebar conversation panel",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "UPSTREAM.json"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gestaltrun/deepseek-harness.git",
    "directory": "product/ui-im"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "candidate"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@gestaltrun/dsh-api-im"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "release:pack": "pnpm build && pnpm pack --pack-destination ../dist"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-schedule": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.5-rc.2",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "6.0.3",
    "tsdown": "0.22.2",
    "vitest": "4.1.8",
    "jsdom": "26.0.0",
    "lightningcss": "1.32.0",
    "@testing-library/react": "16.3.2",
    "clsx": "2.1.1",
    "zustand": "4.4.7",
    "immer": "10.1.1",
    "@gestaltrun/dsh-api-im": "workspace:^",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.2",
    "anser": "2.3.5",
    "katex": "0.16.47",
    "micromark-core-commonmark": "2.0.3",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "micromark-util-types": "2.0.2",
    "shiki": "4.3.1",
    "@shikijs/langs": "4.3.1",
    "micromark-factory-space": "2.0.1",
    "micromark-extension-math": "3.1.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-util-sanitize-uri": "2.0.1",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "types": "lib/types/index.d.ts"
}
