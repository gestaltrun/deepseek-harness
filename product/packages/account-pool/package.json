{
  "name": "@gestaltrun/dsh-account-pool",
  "version": "0.1.0-gestaltrun.0",
  "description": "Embedded CLIProxyAPI accounts, quota observations, and model access for Gestaltrun",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client-types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    }
  },
  "files": [
    "lib",
    "resources",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE",
    "UPSTREAM.json",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gestaltrun/deepseek-harness.git",
    "directory": "product/packages/account-pool"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "candidate"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "pnpm build:host && pnpm build:client",
    "build:host": "pnpm build:remote && tsdown --config tsdown.host.config.ts",
    "build:client": "tsc -b tsconfig.client-build.json && tsdown --config tsdown.client.config.ts",
    "typecheck": "pnpm build:remote && tsc -b tsconfig.client-build.json",
    "test": "vitest run",
    "release:pack": "pnpm build:engine && pnpm build && pnpm pack --pack-destination ../../dist",
    "build:engine": "node scripts/build-engine.mjs",
    "test:build": "node --test scripts/build-engine.test.mjs",
    "build:remote": "node scripts/build-remote.mjs",
    "smoke:package": "node scripts/smoke-package.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "undici": "7.28.0",
    "selfsigned": "5.5.0",
    "js-yaml": "4.2.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
